type Query {
    # Measure
    getMeasureById(id: ID!): GetOneMeasureResponse
    getAllMeasures: GetMeasuresCollectionResponse
    getMeasuresByThingId(thingId: String!): GetMeasuresCollectionResponse
    getMeasuresByThingIdAndDateTimeBetween(thingId: String!,
        timeStart: LocalDateTime!,
        timeEnd: LocalDateTime!): GetMeasuresCollectionResponse
    getTemperaturesByThingIdAndDateTimeBetween(thingId: String!,
        timeStart: LocalDateTime!,
        timeEnd: LocalDateTime!): GetMeasureTemperatureDTOCollectionResponse

    # User
    getUserById(id: ID!): GetOneUserResponse
    getUserByCredentials(username: String!, password: String!): GetOneUserResponse
    getAllUsers: GetUserCollectionResponse
    getUserByEmail(email: String!): GetUserCollectionResponse
    getUsersByUsername(username: String!): GetUserCollectionResponse
    existsUserByEmail(email: String!): Boolean

    # Station
    getStationById(id: ID!): GetOneStationResponse
    getAllStations: GetStationCollectionResponse
    getStationsByUserId(id: Long!): GetStationCollectionResponse
}

# ///////////////////////////// MUTATIONS /////////////////////////

type Mutation {
    # Measure
    saveMeasure(measureInput: MeasureInput!): SaveMeasureResponse
    deleteMeasureById(measureId: ID!): DeleteResponse
    deleteAllMeasures: DeleteResponse
    deleteMeasuresByThingId(thingId : String!): DeleteResponse

    # User
    saveUser(userInput: UserInput!): SaveUserResponse
    deleteUserById(userId: ID!): DeleteResponse
    deleteAllUsers: DeleteResponse

    # Station
    saveStation(stationInput: StationInput!): SaveStationResponse
    deleteStationById(id: ID!): DeleteResponse
    deleteAllStations: DeleteResponse
    changeUserStation(stationId: ID!, userId: ID): GetOneStationResponse
    checkTotalMeasures(stationId: ID!): GetOneStationResponse
}

# ///////////////////////////// INPUTS /////////////////////////
input MeasureInput {
    thingId: String
    meteo: MeteoInput
    battery: BatteryInput
}

input MeteoInput {
    temperature: Float
    humidityRate: Float
    airPressure: Int
}

input BatteryInput {
    batteryState: Int
    outputVoltage: Float
}

input StationInput {
    userId: Long
    startServiceDate: LocalDateTime
    lastMeasureDate: LocalDateTime
    totalMeasures: Long
    firmwareVersion: String
    batteryInput: BatteryInput
}

input UserInput {
    username: String
    password: String
    email: String
    firstName: String
    lastName: String
    birthDate: Date
}

# ///////////////////////////// RESPONSES /////////////////////////

# Measure
type SaveMeasureResponse {
    success: Boolean
    message: String
    measure: Measure
}

type GetMeasuresCollectionResponse{
    success: Boolean
    message: String
    measures: [Measure]
}

type GetMeasureTemperatureDTOCollectionResponse{
    success: Boolean
    message: String
    measureTemperatureDTOCollection: [TemperatureMeasures]
}

type GetOneMeasureResponse{
    success: Boolean
    message: String
    measure: Measure
}

# User
type SaveUserResponse{
    success: Boolean
    message: String
    user: User
}

type GetOneUserResponse{
    success: Boolean
    message: String
    user: User
}

type GetUserCollectionResponse{
    success: Boolean
    message: String
    users: [User]
}

# Station
type SaveStationResponse {
    success: Boolean
    message: String
    station: Station
}

type GetOneStationResponse{
    success: Boolean
    message: String
    station: Station
}

type GetStationCollectionResponse{
    success: Boolean
    message: String
    stations: [Station]
}

# Global
type DeleteResponse {
    success: Boolean
    message: String
}

# ///////////////////////////// TYPE ENTITIES /////////////////////////

type Measure {
    id: ID
    thingId: String
    timestamp: LocalDateTime
    meteo: Meteo
    battery: Battery
}

type Station {
    id: ID
    userId: Long
    startServiceDate: LocalDateTime
    lastMeasureDate: LocalDateTime
    totalMeasures: Long
    firmwareVersion: String
    battery: Battery
}

type TemperatureMeasures{
    timestamp: LocalDateTime
    temperature: Float
}

type Meteo {
    temperature: Float
    humidityRate: Float
    airPressure: Float
}

type Battery {
    batteryState: Int
    outputVoltage: Float
}

type User {
    id: ID
    username: String
    password: String
    email: String
    firstName: String
    lastName: String
    birthDate: Date
    createdAt: LocalDateTime
}

# ///////////////////////////// SCALAR /////////////////////////
scalar DateTime
scalar LocalDateTime
scalar Date
scalar Long