type Query {
    # Measure
    getMeasureById(id: ID!): GetOneMeasureResponse
    getAllMeasures: GetMeasuresCollectionResponse
    getMeasuresByThingId(thingId: String!): GetMeasuresCollectionResponse
    getMeasuresByThingIdAndDateTimeBetween(thingId: String!,
        timeStart: LocalDateTime!,
        timeEnd: LocalDateTime!): GetMeasuresCollectionResponse
}

# ///////////////////////////// MUTATIONS /////////////////////////

type Mutation {
    #Measure
    saveMeasure(measureInput: MeasureInput!): SaveMeasureResponse
    deleteById(measureId: ID!): DeleteResponse
    deleteAllMeasures: DeleteResponse
    deleteMeasuresByThingId(thingId : String!): DeleteResponse
}

# ///////////////////////////// INPUTS /////////////////////////
input MeasureInput {
    thingId: String
    meteo: MeteoInput
    battery: BatteryInput
}

input MeteoInput {
    temperature: Float
    humidityRate: Float
    airPressure: Int
}

input BatteryInput {
    batteryState: Int
    outputVoltage: Float
}

# ///////////////////////////// RESPONSES /////////////////////////

type SaveMeasureResponse {
    success: Boolean
    message: String
    measure: Measure
}

type GetMeasuresCollectionResponse{
    success: Boolean
    message: String
    measures: [Measure]
}

type GetOneMeasureResponse{
    success: Boolean
    message: String
    measure: Measure
}

type DeleteResponse {
    success: Boolean
    message: String
}

# ///////////////////////////// TYPE ENTITIES /////////////////////////

type Measure {
    id: ID
    thingId: String
    timestamp: String
    meteo: Meteo
    battery: Battery
}

type Meteo {
    temperature: Float
    humidityRate: Float
    airPressure: Float
}

type Battery {
    batteryState: Int
    outputVoltage: Float
}

# ///////////////////////////// SCALAR /////////////////////////
scalar DateTime
scalar LocalDateTime